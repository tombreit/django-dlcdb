#: dlcdb/accounts/templates/accounts/groups/delete.html:18
#, python-format
msgid ""
"Its %(counter)s active member loses the permissions and tenants the group "
"gives."
msgid_plural ""
"Its %(counter)s active members lose the permissions and tenants the group "
"gives."
msgstr[0] ""
"Ihr %(counter)s aktives Mitglied verliert die Berechtigungen und Mandanten, "
"die die Gruppe vergibt."
msgstr[1] ""
"Ihre %(counter)s aktiven Mitglieder verlieren die Berechtigungen und "
"Mandanten, die die Gruppe vergibt."

#: dlcdb/accounts/templates/accounts/groups/delete.html:21
msgid ""
"LDAP creates the group again at the next login of one of its members, "
"without permissions or tenants."
msgstr ""
"LDAP legt die Gruppe beim nächsten Login eines ihrer Mitglieder wieder an, "
"ohne Berechtigungen und Mandanten."

